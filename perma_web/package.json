    "@babel/preset-env": "^8.0.2",
    "@popperjs/core": "^2.11.8",
    "@vitejs/plugin-vue": "^6.0.8",
    "@vue/compiler-sfc": "^3.5.42",
    "@vue/test-utils": "^2.5.0",
    "autoprefixer": "^10.5.4",
    "babel-loader": "^10.1.1",
    "babel-plugin-polyfill-corejs3": "^1.0.0",
    "bootstrap": "^5.3.8",
    "css-loader": "^7.1.5",
    "handlebars": "^4.7.9",
    "jquery": "^4.0.0",
    "jsdom": "^30.0.1",
