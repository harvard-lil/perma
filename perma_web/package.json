    "webpack-bundle-tracker": "^3.2.4",
    "webpack-cli": "^7.2.3"
  },
  "//overrides": "jstree 3.3.x declares peerDependencies jquery ^3.5.0, which excludes jQuery 4. Without this override npm does not fail -- it silently nests a second jQuery 3.7.1 under node_modules/jstree, so jsTree would register $.fn.jstree on a different jQuery instance than ProvidePlugin injects into application code, breaking the folder tree at runtime with a green build. jsTree's source was scanned and uses none of the APIs jQuery 4 removed. Revisit if jsTree ships a release declaring jQuery 4 support, or if its source starts using a removed API.",
  "overrides": {
    "jstree": {
      "jquery": "$jquery"
    }
  },
  "dependencies": {
    "@babel/runtime-corejs3": "^8.0.0",
    "@sentry/browser": "^10.73.0",
    "@vueuse/core": "^14.4.0",
    "core-js-pure": "^3.50.0",
    "pinia": "^4.0.3",
    "vue": "^3.5.42",
    "vue-loader": "^17.4.2"
  }
}
